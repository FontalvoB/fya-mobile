{
  "expo": {
    "name": "FYA · Tus próximos planes",
    "slug": "fya-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/fya-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fyasocialcapital.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D3429",
        "foregroundImage": "./assets/fya-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fyasocialcapital.mobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/fya-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permite a FYA tomar una selfie opcional para esta demostración.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "fyamobile",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d611e7ae-6a2a-4f77-8eb9-038df5269351"
      }
    },
    "owner": "fontalvob"
  }
}
